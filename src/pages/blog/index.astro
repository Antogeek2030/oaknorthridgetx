---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'AC Tips | AC Repair Oak Ridge North TX Blog';
const description = 'Practical articles on air conditioning care, summer readiness, and cooling troubleshooting for Oak Ridge North and Woodlands homeowners.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Blog</span>
      </nav>
      <h1>AC Tips &amp; Advice</h1>
      <p>Helpful guidance for Oak Ridge North area homeowners on air conditioning care and summer readiness.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {posts.map((post) => (
          <article class="card">
            <time datetime={post.data.pubDate.toISOString()} style="font-size:0.85rem;color:var(--color-muted);">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 style="font-size:1.2rem;margin-top:0.5rem;">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="btn btn-outline" style="padding:0.5rem 1rem;font-size:0.9rem;">Read article</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

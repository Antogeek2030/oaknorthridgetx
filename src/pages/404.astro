---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found | AC Repair Oak Ridge North TX';
const description = 'The page you requested could not be found. Return home or contact us for AC repair in Oak Ridge North, TX.';
---

<BaseLayout title={title} description={description}>
  <section class="section" style="text-align:center;padding:5rem 1rem;">
    <div class="container">
      <h1 style="font-size:3rem;margin-bottom:0.5rem;">404</h1>
      <h2>Page Not Found</h2>
      <p style="max-width:480px;margin:1rem auto 2rem;color:var(--color-muted);">
        Sorry, we could not find the page you were looking for. It may have been moved or the link may be incorrect.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;">
        <a href="/" class="btn btn-primary">Go Home</a>
        <a href="/services/" class="btn btn-outline">Browse Services</a>
        <a href="/contact/" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Terms of Service | AC Repair Oak Ridge North TX';
const description = 'Terms of service for acrepairoakridgenorthtx.us and AC services in the Oak Ridge North, TX area.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Terms of Service</span>
      </nav>
      <h1>Terms of Service</h1>
      <p>Last updated: November 2026</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:800px;">
      <p>
        By accessing acrepairoakridgenorthtx.us or engaging our air conditioning services, you agree to these Terms of Service.
      </p>
      <h2>Services</h2>
      <p>
        We provide residential AC repair, maintenance, and installation services in the Oak Ridge North, TX area. Specific work is governed by the estimate, work order, or invoice provided for each job.
      </p>
      <h2>Website Content</h2>
      <p>
        Information on this website is provided for general guidance and does not constitute a binding offer. Prices, availability, and service details may change. Always confirm current information when you contact us.
      </p>
      <h2>Estimates and Pricing</h2>
      <p>
        Estimates are based on the information available at the time. Final pricing may vary if additional issues are discovered or if the scope changes with your approval.
      </p>
      <h2>Scheduling and Access</h2>
      <p>
        Service appointments require reasonable access to the equipment and work areas. You are responsible for ensuring that pets are secured and that we can reach the system safely.
      </p>
      <h2>Limitation of Liability</h2>
      <p>
        To the fullest extent permitted by law, our liability for any claim arising from services or use of this website is limited to the amount paid for the specific service giving rise to the claim. We are not liable for indirect, incidental, or consequential damages.
      </p>
      <h2>Warranties</h2>
      <p>
        Manufacturer warranties on equipment and parts apply according to the manufacturer’s terms. Any labor warranty we provide will be stated on the invoice or work order for that job.
      </p>
      <h2>Governing Law</h2>
      <p>
        These terms are governed by the laws of the State of Texas. Any disputes will be resolved in the courts of Montgomery County, Texas, unless otherwise required by law.
      </p>
      <h2>Changes</h2>
      <p>
        We may update these terms from time to time. Continued use of the website or services after changes constitutes acceptance of the revised terms.
      </p>
      <h2>Contact</h2>
      <p>
        Questions about these terms can be directed through our <a href="/contact/">contact page</a> or by mail to 27355 Blueberry Hill Dr #41, Oak Ridge North, TX 77385.
      </p>
    </div>
  </section>
</BaseLayout>
